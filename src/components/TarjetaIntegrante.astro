---
// Tarjeta de un integrante para la landing (US-401). Linkea a su CV en /equipo/<slug>/.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  integrante: CollectionEntry<'integrantes'>;
}

const { integrante } = Astro.props;
const { nombre, rol, foto, email, linkedin, github } = integrante.data;
const urlCv = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}equipo/${integrante.id}/`;
// Iniciales para el avatar cuando no hay foto: 'Nicolas Piñera' → 'NP'.
const iniciales = nombre
  .split(' ')
  .map((parte) => parte[0])
  .join('')
  .slice(0, 2);
---

<article class="tarjeta-proyecto tarjeta-integrante">
  {foto ? (
    <Image src={foto} alt={`Foto de ${nombre}`} width={96} height={96} class="cv-avatar" />
  ) : (
    <div class="cv-avatar" aria-hidden="true">
      {iniciales}
    </div>
  )}
  <h3>
    <a href={urlCv}>{nombre}</a>
  </h3>
  <p>{rol}</p>
  <ul class="cv-contacto">
    <li>
      <a href={`mailto:${email}`}>Mail</a>
    </li>
    <li>
      <a href={linkedin}>LinkedIn</a>
    </li>
    <li>
      <a href={github}>GitHub</a>
    </li>
    <li>
      <a href={urlCv}>Ver CV →</a>
    </li>
  </ul>
</article>
